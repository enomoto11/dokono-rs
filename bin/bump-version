#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: $0 <new-version>" >&2
  echo "example: $0 0.5.0" >&2
  exit 1
fi

NEW="$1"

if ! echo "$NEW" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
  echo "error: version must be X.Y.Z (got: $NEW)" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

CURRENT=$(grep -E '^version = "' Cargo.toml | head -1 | sed -E 's/^version = "([^"]+)"/\1/')
if [ -z "$CURRENT" ]; then
  echo "error: could not read current version from Cargo.toml" >&2
  exit 1
fi

if [ "$CURRENT" = "$NEW" ]; then
  echo "version is already $NEW; nothing to do"
  exit 0
fi

echo "bumping $CURRENT -> $NEW"

# Workspace.package version; each crate inherits via `version.workspace = true`.
sed -i.bak -E "s/^version = \"$CURRENT\"$/version = \"$NEW\"/" Cargo.toml
rm Cargo.toml.bak

# Rewrite intra-workspace `dokono-* = { path = "...", version = "X" }` deps in every crate,
# so adding a new dokono-* crate doesn't require touching this script.
TOUCHED=(Cargo.toml)
for cargo in crates/*/Cargo.toml; do
  sed -i.bak -E "s|(dokono-[a-z0-9_-]+ = \\{[^}]*version = )\"$CURRENT\"|\\1\"$NEW\"|g" "$cargo"
  rm "$cargo.bak"
  TOUCHED+=("$cargo")
done

if git diff --quiet "${TOUCHED[@]}"; then
  echo "error: no changes were made — check the version pattern in Cargo.toml files" >&2
  exit 1
fi

echo "updating Cargo.lock ..."
cargo check --workspace --quiet

echo
echo "done. next steps:"
echo "  git add -A && git commit -m 'release: v$NEW'"
echo "  git push origin main"
echo "  git tag v$NEW"
echo "  git push origin v$NEW"
